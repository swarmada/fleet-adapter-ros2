# R1/R2 testbed image for fleet-adapter-ros2.
#
# Jazzy is the ROS 2 LTS and the distro CONTRIBUTING.md already names. Its system
# Python is 3.12, which satisfies the adapter's requires-python = ">=3.12".
# The base image is multi-arch, so this builds natively on Apple Silicon.
FROM ros:jazzy-ros-base

SHELL ["/bin/bash", "-c"]

# nav2-msgs           - the ONE Nav2-specific dependency (NavigateToPose action type)
# nav2-bringup / -map-server / -amcl - R2 only; harmless at R1
# python3-pip, venv   - to install the adapter and the SDK
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-nav2-msgs \
      ros-jazzy-nav2-bringup \
      ros-jazzy-nav2-map-server \
      ros-jazzy-nav2-amcl \
      ros-jazzy-tf2-ros \
      python3-pip python3-venv python3-numpy \
      python3-paho-mqtt mosquitto-clients \
      git make \
 && rm -rf /var/lib/apt/lists/*

# DIAGNOSTIC TOOLING. Neither of these changes the default RMW, which stays
# rmw_fastrtps_cpp (set below and in docker-compose.yml's x-ros-env).
#
#   rmw_cyclonedds_cpp : lets an identical run be repeated under a different DDS
#                        implementation, which is the cheapest way to decide whether an
#                        observed fault is Fast DDS-specific or ours. Selected PER RUN with
#                        RMW_IMPLEMENTATION=rmw_cyclonedds_cpp, never by default --
#                        R3.md 3.3 requires ONE pinned RMW across Isaac and Nav2, so
#                        changing the default is a decision with downstream consequences,
#                        not a knob.
#   py-spy             : sample the stack of a running Python process WITHOUT stopping it.
#                        `py-spy dump --pid $(pgrep -fn r2_sensors.py)` -- note `-fn`:
#                        plain `-f` also matches the bash wrapper and py-spy refuses two PIDs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-rmw-cyclonedds-cpp \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir --break-system-packages py-spy

# The adapter and the SDK are installed from the mounted source tree at runtime
# (see testbed/Makefile `deps`), NOT baked in -- you are iterating on that source.
# --break-system-packages is required on Noble's PEP 668 Python.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# The committed *_pb2.py stubs are generated by protoc 6.33.5 and call
# `runtime_version.ValidateProtobufRuntimeVersion(... 6, 33, 5 ...)`, which does not
# exist before protobuf 5.27. Ubuntu Noble / ROS Jazzy ship protobuf 4.25 in
# /usr/lib/python3/dist-packages, so `import fleet_adapter_pb2` fails outright.
#
# pip installs to /usr/local/lib/python3.12/dist-packages, which precedes the system
# path, so this shadows the distro package without removing it.
#
# NOTE: every pyproject.toml in the project declares `protobuf>=4.25`, which is
# WRONG for these stubs. This line is the testbed's workaround; the
# real fix is the declared floor in the five packages.
RUN pip install --no-cache-dir --upgrade 'protobuf>=6.33.5' 'grpcio>=1.60' \
 && python3 -c "import google.protobuf as p; print('protobuf', p.__version__)"
ENV ROS_DOMAIN_ID=42
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV PYTHONUNBUFFERED=1

WORKDIR /ws

# Source the ROS overlay for every RUN/CMD in this image.
RUN echo 'source /opt/ros/jazzy/setup.bash' >> /etc/bash.bashrc

CMD ["bash"]
